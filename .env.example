# Kopieren nach .env und anpassen

# Passwort für die Fragenverwaltung (/admin) und die Fragen-API.
# Leer lassen = Verwaltung abgeschaltet. Erzeugen z. B. mit: openssl rand -base64 24
ADMIN_TOKEN=

# Öffentliche Adresse, die im QR-Code landet (ohne / am Ende).
# Leer lassen = wird aus der Anfrage abgeleitet.
PUBLIC_URL=https://quiz.example.de

# Hinter einem Reverse Proxy (Caddy, Traefik, nginx): X-Forwarded-* Header vertrauen
TRUST_PROXY=true

# Spielräume ohne Aktivität nach so vielen Stunden aufräumen
ROOM_TTL_HOURS=12
