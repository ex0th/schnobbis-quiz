{
  "name": "schnobbis-quiz",
  "version": "2.0.0",
  "description": "Allgemeinwissen-Quiz für den Spieleabend – self-hosted, mit Multiplayer über WebSockets",
  "type": "module",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.js'",
    "import": "node --disable-warning=ExperimentalWarning scripts/import-questions.js"
  },
  "dependencies": {
    "uqr": "^0.1.3",
    "ws": "^8.22.0"
  }
}
